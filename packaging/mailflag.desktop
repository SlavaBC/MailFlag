[Desktop Entry]
Type=Application
Name=MailFlag
GenericName=Mail notifier
Comment=Fast multi-account Yahoo mail and OTP notifications
Exec=/usr/bin/mailflag --settings
Icon=/usr/share/icons/hicolor/128x128/apps/mailflag.png
Terminal=false
Categories=Network;Email;
StartupNotify=false
StartupWMClass=mailflag
