{
  "metadata": {
    "name": "MailFlag OTP Regression Corpus v2",
    "version": "2.0",
    "purpose": "Second-pass adversarial regression corpus after fixes found with v1",
    "format": "UTF-8 JSON",
    "case_count": 120,
    "otp_count": 60,
    "normal_count": 60,
    "policy": {
      "supported_numeric_otp_length": "4-8 digits",
      "leading_zero_codes": "supported and expected_code is stored as a string",
      "classification_bias": "Prefer NORMAL when context is ambiguous",
      "spaced_codes": "not included as OTP in v2",
      "hyphenated_codes": "not included as OTP in v2",
      "alphanumeric_codes": "not included as OTP in v2",
      "quoted_old_codes": "covered in v1; v2 focuses on new semantic/contextual traps"
    },
    "schema": {
      "id": "unique string",
      "subject": "email subject",
      "body": "plain text or HTML-like body",
      "expected_type": "OTP or NORMAL",
      "expected_code": "string for OTP, null for NORMAL",
      "category": "test category",
      "difficulty": "easy, medium or hard",
      "comment": "reason for the case"
    }
  },
